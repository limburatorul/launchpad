<Window x:Class="Launchpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protagonist Labs Launchpad" Width="1180" Height="860" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Ground}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Icon="pack://application:,,,/app.ico"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- the filters, and what Launchpad itself does -->
        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,16">
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,4,0">
                    <CheckBox x:Name="StartWithWindows" Style="{StaticResource Toggle}" Content="Start with Windows" FontSize="12" />
                    <TextBlock x:Name="Checked" Foreground="{StaticResource TextMute}" FontSize="12" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button x:Name="CheckNow" Style="{StaticResource LinkButton}" Content="Check now" FontSize="12" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMute}" FontSize="12" />
                        <Button x:Name="WhatsNew" Style="{StaticResource LinkButton}" Content="What's new" FontSize="12" />
                    </WrapPanel>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="ShowAll" Style="{StaticResource NavButton}" GroupName="f" IsChecked="True">
                        <DockPanel Width="160"><TextBlock x:Name="CountAll" DockPanel.Dock="Right" Foreground="{StaticResource TextMute}" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="All apps" /></DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="ShowUpdates" Style="{StaticResource NavButton}" GroupName="f">
                        <DockPanel Width="160">
                            <Border x:Name="UpdatesBadge" DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="9" Padding="7,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CountUpdates" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="Updates" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="ShowInstalled" Style="{StaticResource NavButton}" GroupName="f">
                        <DockPanel Width="160"><TextBlock x:Name="CountInstalled" DockPanel.Dock="Right" Foreground="{StaticResource TextMute}" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Installed" /></DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="ShowMissing" Style="{StaticResource NavButton}" GroupName="f">
                        <DockPanel Width="160"><TextBlock x:Name="CountMissing" DockPanel.Dock="Right" Foreground="{StaticResource TextMute}" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Not installed" /></DockPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScroll}" />
            </ScrollViewer.Resources>
            <StackPanel Margin="26,22,26,26">
                <!-- shown only while something has an update -->
                <Border x:Name="Hero" Background="{StaticResource HeroBack}" BorderBrush="#3B2A60" BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,8" ClipToBounds="True">
                    <DockPanel>
                        <Button x:Name="HeroButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="22,11" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <Grid x:Name="HeroIcons" DockPanel.Dock="Left" Margin="0,0,22,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeroTitle" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="HeroNotes" Foreground="#C9C3E0" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel x:Name="Sections" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
